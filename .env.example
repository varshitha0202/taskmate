# ----------------------------
# Backend / API server settings
# ----------------------------
PORT=3001
HOST=0.0.0.0
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Keep Supabase secret/service-role keys only on the backend.
# Never expose them to the browser or frontend build.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-service-role-secret
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-secret
SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key

# ----------------------------
# Frontend / browser settings
# ----------------------------
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# Optional Vite dev proxy targets for local development.
VITE_API_PROXY_TARGET=http://localhost:3001
VITE_WS_PROXY_TARGET=ws://localhost:3001
VITE_PORT=5173
