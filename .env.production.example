PORT=3001
JWT_SECRET=replace-with-a-long-random-secret

# Public API endpoints used by the browser when deployed remotely
VITE_API_BASE_URL=https://api-your-app.example.com
VITE_WS_URL=wss://api-your-app.example.com/ws

# Supabase keys for cloud database / auth / realtime
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: if you use local SQLite in dev, keep this blank in production.
# In production, move the app to Supabase/Postgres for multi-user cloud storage.
